  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "eslint": "^10.7.0",
    "fast-check": "^4.9.0",
    "publint": "^0.3.21",
    "tsup": "^8.5.1",
